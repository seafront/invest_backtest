# 한국투자증권 Open API 자격증명
#
#   cp backend/.env.example backend/.env
#
# .env 는 .gitignore 에 있어 커밋되지 않는다. 이 저장소는 공개돼 있으므로
# 키를 코드나 커밋 메시지에 넣지 말 것.

# 어느 환경을 쓸지 고른다. 실험 중에는 paper 로 둔다.
#   paper = 모의투자 (openapivts.koreainvestment.com:29443)
#   real  = 실전     (openapi.koreainvestment.com:9443)
KIS_ENV=paper

# 모의투자 앱키. KIS_ENV=paper 일 때 쓰인다.
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=

# 실전 앱키. KIS_ENV=real 일 때만 쓰인다.
# 실전 키는 시세뿐 아니라 주문 API까지 열리므로 다루기 전에 한 번 더 생각할 것.
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=

# 계좌번호 앞 8자리-뒤 2자리. 시세 조회에는 필요 없고 주문·잔고에 쓰인다.
KIS_PAPER_ACCOUNT=
KIS_REAL_ACCOUNT=
